# --------------------------------------------
# DATABASE (Vercel Postgres / Supabase / Neon)
# --------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/portfolio?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/portfolio?schema=public"

# --------------------------------------------
# AUTH (NextAuth.js)
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# --------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Initial admin account (used by `npm run db:seed`)
ADMIN_EMAIL="asisjha15@gmail.com"
ADMIN_NAME="Aashish Kumar Jha"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# --------------------------------------------
# FILE STORAGE — Vercel Blob
# Create in: Vercel Dashboard → Storage → Blob
# Leave empty for local dev (files are saved to /public/uploads instead)
# --------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# --------------------------------------------
# EMAIL — Resend (contact form notifications)
# Create in: https://resend.com/api-keys
# Leave empty to skip sending emails (messages still saved to DB)
# --------------------------------------------
RESEND_API_KEY=""
CONTACT_TO_EMAIL="asisjha15@gmail.com"
# Optional: verified sender, e.g. "Portfolio <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# --------------------------------------------
# SITE
# --------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
